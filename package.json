{
  "name": "elysium-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Next-generation agent harness: minimal Pi-style core with hierarchical orchestration and quality gates as first-class extensions.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "demo": "tsx examples/demo/run.ts",
    "agent": "tsx bin/agent.ts",
    "agent:mock": "tsx bin/agent.ts --provider mock"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@elysium/core": "workspace:*"
  }
}
